# ─────────────────────────────────────────────────────────────────────────────
# Assay environment. Copy to `.env.local` and fill in.
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ─────────────────────────────────────────────────────
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, bypasses RLS (background jobs only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# After setting these, run every migration in supabase/migrations/ in order,
# in the Supabase SQL editor. They create the scans / scan_findings /
# ownership_proofs / scan_usage / monitored_apps / email_log / subscriptions /
# rate_limits / agent_messages / api_keys tables, all with RLS.

# ── Site URL ────────────────────────────────────────────────────────────────
# Absolute base URL, no trailing slash. Used for links in emails, the sitemap,
# robots.txt, and the OAuth return address. It must also be listed under
# Supabase → Authentication → URL Configuration, or sign-in silently drops the
# user on the landing page with no session.
NEXT_PUBLIC_SITE_URL=https://assaysecurity.com

# ── Anthropic (required for plain-language fixes) ───────────────────────────
# Without it, scans still complete using raw finding text; the /sample demo
# report renders with no keys at all.
ANTHROPIC_API_KEY=sk-ant-...

# ── Inngest (optional in dev, required in prod) ─────────────────────────────
# Drives the every-3-hours re-check of watched apps and the weekly digest.
# Without it monitoring never runs — and monitoring is the paid product, so
# this failing quietly is the most expensive silence in the app.
# In dev the Inngest dev server runs keyless (npx inngest-cli@latest dev).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Resend (email alerts — optional) ────────────────────────────────────────
# Powers the regression alert ("a change opened a security hole") and the
# weekly watch digest. Without it, scans + monitoring still work; the app just
# never emails. Create a key at https://resend.com and verify the sending
# domain — an unverified sender is rejected on every send.
RESEND_API_KEY=
EMAIL_FROM="Assay <alerts@assaysecurity.com>"

# ── Lemon Squeezy (billing — optional) ──────────────────────────────────────
# Powers paid plans (Pro/Team). Lemon Squeezy is the merchant of record, so it
# also collects and remits VAT/sales tax. Without these, everyone is on Free
# and upgrades are disabled — the app runs fully.
#
# Settings → API → create an API key.
LEMONSQUEEZY_API_KEY=
# Settings → Stores → the numeric store id.
LEMONSQUEEZY_STORE_ID=
# Settings → Webhooks → create one pointing at
# <site>/api/webhooks/lemonsqueezy, subscribed to exactly these events:
#   subscription_created, subscription_updated, subscription_resumed,
#   subscription_unpaused, subscription_cancelled, subscription_expired,
#   subscription_paused
LEMONSQUEEZY_WEBHOOK_SECRET=
# Products → the plan's variant → copy the numeric variant id, not the product id.
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_TEAM=
# "true" makes checkouts open in Lemon Squeezy's test mode. Refused outright on
# the production deployment (see lemonSqueezyTestModeOnProduction in lib/env.ts)
# — there is no legitimate reason for the live site to open a test checkout.
LEMONSQUEEZY_TEST_MODE=

# ── Abuse ceiling (optional) ────────────────────────────────────────────────
# Total anonymous /try scans allowed per day across everyone — a circuit
# breaker on spend, since each one costs a real Anthropic call and /try needs
# no account. Defaults to 250 when unset or unparseable; the hourly ceiling is
# derived from it. A typo here can only tighten the limit, never remove it.
ANON_SCAN_BUDGET_DAILY=250

# ── GitHub sign-in (OAuth) ──────────────────────────────────────────────────
# Auth is Supabase Auth → GitHub, used ONLY to sign users into Assay (no repo
# access). Create a classic OAuth App at https://github.com/settings/developers
# and put its client id/secret into the Supabase GitHub provider
# (Authentication → Providers) — not read from this file, just recorded here
# for reference. Add <your-site>/auth/callback as the redirect URL.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
